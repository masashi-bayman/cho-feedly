# このファイルを .env にコピーして実際の値を入れてください
# .env は .gitignore 済みです

# Discord の「サーバー設定 → 連携サービス → ウェブフック」で発行
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxxxxx/yyyyyyyy

# PWA サイトの公開 URL（digest.json の digest_url に埋め込まれます）
# 末尾のスラッシュは付けないこと
DIGEST_BASE_URL=https://自分のドメイン/daily

# 生成した静的 HTML の出力先。
# nginx が配っているディレクトリ（root）の配下でないと、生成しても配信されない。
# root の場所は次で確認できる:
#     sudo nginx -T 2>/dev/null | grep "root "
DIGEST_OUTPUT_DIR=/var/www/portal/public/daily

# 将来の拡張: 要約に Claude API を使う場合のみ設定
# ANTHROPIC_API_KEY=
