# このファイルを .env にコピーして実際の値を入れてください
# .env は .gitignore 済みです

# Discord の「サーバー設定 → 連携サービス → ウェブフック」で発行
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxxxxx/yyyyyyyy

# PWA サイトの公開 URL（digest.json の digest_url に埋め込まれます）
# 末尾のスラッシュは付けないこと
DIGEST_BASE_URL=https://自分のドメイン/daily

# 生成した静的 HTML の出力先。
#
# 注意点が 3 つある（詳しくは deploy/README.md の「PWA サイト」）:
#   1. リポジトリとは別の場所にすること。ここへソースを cp してはいけない
#      （この .env ごと公開領域に置くことになる）
#   2. 所有者は pi にすること。run_daily.py は pi として動くので、
#      www-data の持ち物にすると書き込めずに失敗する
#   3. nginx の root の外に置くなら、alias の location が要る
DIGEST_OUTPUT_DIR=/var/www/daily

# 将来の拡張: 要約に Claude API を使う場合のみ設定
# ANTHROPIC_API_KEY=
